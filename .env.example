# Copy this file to .env at the repo root and fill in real values.
# Used by server/backend/env.js (loaded first, before any other server
# module) and by docker-compose.yml's env_file.

# --- Twitch app (https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OAuth redirect URIs registered on the Twitch app, pointing at the server.
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
TWITCH_BOT_REDIRECT_URI=http://localhost:3000/auth/twitch-bot/callback

# --- LuBot chat-bot account (one shared Twitch account for all tenants) ---
# Seed values; after the first successful /auth/twitch-bot/login they're
# refreshed automatically and persisted in lubot_tokens, so these only
# matter for the very first boot.
LUBOT_BOT_NAME=
LUBOT_OAUTH_TOKEN=
LUBOT_REFRESH_TOKEN=

# --- App URLs ---
# Base URL of the deployed client, used for CORS (both Express and
# Socket.IO) and for post-login redirects.
FRONTEND_BASE_URL=http://localhost:5173

# --- Session ---
# Secret used to sign the JWT stored in the "sid" cookie.
JSON_WEB_TOKEN=
