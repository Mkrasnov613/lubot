# Copy this file to .env at the repo root and fill in real values.
# Used by server/backend/env.js (loaded first, before any other server
# module) and by docker-compose.yml's env_file.

# --- Twitch app (https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OAuth redirect URIs registered on the Twitch app.
#
# The broadcaster flow must come back through the *client's* origin, via the
# /backend/:path* rewrite in client/next.config.ts. That is what makes the `sid`
# cookie first-party; pointed straight at the server it lands on the server's
# host and the client can never read it. In production this is
# https://<your-app>.vercel.app/backend/auth/twitch/callback.
TWITCH_REDIRECT_URI=http://localhost:5173/backend/auth/twitch/callback
#
# The bot flow is an operator-only page opened directly on the server, so it
# stays on the server's own origin — its state cookie is set and read on the
# same host.
TWITCH_BOT_REDIRECT_URI=http://localhost:3000/auth/twitch-bot/callback

# --- LuBot chat-bot account (one shared Twitch account for all tenants) ---
# Seed values; after the first successful /auth/twitch-bot/login they're
# refreshed automatically and persisted in lubot_tokens, so these only
# matter for the very first boot.
LUBOT_BOT_NAME=
LUBOT_OAUTH_TOKEN=
LUBOT_REFRESH_TOKEN=

# --- App URLs ---
# Base URL of the deployed client, used for CORS (both Express and Socket.IO),
# for post-login redirects, and to decide whether cookies get the Secure flag
# (utils/session.js keys off the https:// scheme here, because neither
# `npm run start` nor the Dockerfile sets NODE_ENV).
FRONTEND_BASE_URL=http://localhost:5173

# --- Session ---
# Secret used to sign the JWT stored in the "sid" cookie.
JSON_WEB_TOKEN=

# --- Database (Neon serverless Postgres) ---
# Connection string from the Neon dashboard, with "Connection pooling" turned
# ON — the host must contain "-pooler". The non-pooled host is only for
# occasional pg_dump/psql work, not for the server.
# db/connection.js upgrades sslmode=require to verify-full; don't drop sslmode.
#
# The Neon project has two branches, and which one you point at is decided
# ONLY by the endpoint host in this URL:
#   dev        ep-tiny-mouse-b2z9q1v9-pooler…  ← use this locally
#   production ep-sweet-tree-b2ygifl7-pooler…  ← real streamer OAuth tokens
# Both branches share the same role and password, so switching branches is a
# hostname swap and nothing else. Your local .env should name the *dev* host;
# production sets DATABASE_URL from its own deploy environment, never from a
# committed file.
DATABASE_URL=postgresql://USER:PASSWORD@ep-tiny-mouse-b2z9q1v9-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require
