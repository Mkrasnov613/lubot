# Copy this file to client/.env.local and fill in real values.

# Origin of the Express server. This is NOT the browser's API base — the browser
# talks to this app's own origin under /backend, which next.config.ts rewrites to
# the value below (keeping the session cookie first-party). It is used as that
# rewrite's destination, and directly by the two things the rewrite can't carry:
# Server Component fetches and the Socket.IO connection.
NEXT_PUBLIC_API_URL=http://localhost:3000
